---
import BaseLayout from "../layouts/BaseLayout.astro";
import catalogJson from "../data/catalog.json";
import egawaJson from "../data/akira-egawa.json";
import tengoJson from "../data/tengo.json";
import sleevesJson from "../data/sleeves.json";
import { cardCode, progress, type CardSet } from "../lib/progress";

// One page per collection; both share the same markup and tengo.json.
export function getStaticPaths() {
  return [
    {
      params: { page: undefined },
      props: {
        catalog: catalogJson as CardSet[],
        heading: "Master set Siniestros",
        eyebrow: "Pokémon TCG · Tipo Oscuridad",
        credits: "TCGdex",
      },
    },
    {
      params: { page: "akira-egawa" },
      props: {
        catalog: egawaJson as CardSet[],
        heading: "Colección Akira Egawa",
        eyebrow: "Pokémon TCG · Ilustraciones de Akira Egawa",
        credits: "TCGdex y Pokémon TCG API",
        title: "Colección Akira Egawa — Pokémon TCG",
        description: "Seguimiento personal de las cartas de Pokémon TCG ilustradas por Akira Egawa.",
      },
    },
  ];
}

const { page } = Astro.params;
const { catalog, heading, eyebrow, credits, title, description } = Astro.props;
const nav = [
  { page: undefined, label: "Siniestros" },
  { page: "akira-egawa", label: "Akira Egawa" },
];
// ETB sleeves are tracked only in the Siniestros master set.
const hasSleeves = page === undefined;
const owned = new Set<string>(tengoJson as string[]);
// Sleeve photo filenames (public/sleeves) for the Elite Trainer Box sleeves I own.
const sleeves = new Set<string>(sleevesJson as string[]);
// ETB sleeve photos in public/sleeves (sourced from GameStop, Bulbagarden, retailers).
// Prismatic, Journey Together, Mega Evolution, Black Bolt, Chaos Rising and 30th are my own photos.
const SLEEVE_IMGS: Record<string, string[]> = !hasSleeves ? {} : {
  "sv08.5": ["sv08.5.jpg"], sv09: ["sv09.jpg"], sv10: ["sv10.webp"],
  "sv10.5w": ["sv10.5w.webp"], "sv10.5b": ["sv10.5b.jpg"],
  me01: ["me01-lucario.jpg", "me01-gardevoir.jpg"], me02: ["me02.webp"],
  "me02.5": ["me02.5.webp"], me03: ["me03.webp"], me04: ["me04.jpg"],
  me05: ["me05.webp"], "30th": ["30th.jpg"], me06: ["me06.png"],
};
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const all = progress(catalog.flatMap((s) => s.cards), owned);
const sleeveFiles = catalog.flatMap((set) => (SLEEVE_IMGS[set.id] ?? []).map((f) => ({ set, f })));
const missingSleeves = sleeveFiles.filter(({ f }) => !sleeves.has(f));
// A set without sleeve photos yet counts as missing ([].every() is true).
const setHasSleeves = (id: string) => SLEEVE_IMGS[id]?.every((f) => sleeves.has(f)) ?? false;
---

<BaseLayout title={title} description={description}>
  <header class="masthead">
    <div class="masthead-in">
      <div class="brand">
        <nav class="collections" aria-label="Colecciones">
          {nav.map((n) => (
            <a class="chip" href={n.page ? `${base}${n.page}/` : base} aria-current={n.page === page ? "page" : undefined}>{n.label}</a>
          ))}
        </nav>
        <p class="eyebrow">{eyebrow}</p>
        <h1>{heading}</h1>
      </div>
      <div class="tally">
        <div class="tally-item"><span class="tally-n mono">{all.owned}/{all.total}</span><span class="tally-l">Cartas</span></div>
        <div class="tally-item"><span class="tally-n mono">{all.pct}%</span><span class="tally-l">Completado</span></div>
        {hasSleeves && <div class="tally-item"><span class="tally-n mono">{sleeveFiles.length - missingSleeves.length}/{sleeveFiles.length}</span><span class="tally-l">Sleeves ETB</span></div>}
      </div>
      <div class="head-actions">
        <button class="btn" id="pdfBtn" title="Abre imprimir: elige «Guardar como PDF»">Descargar PDF de faltantes</button>
        <button class="btn btn-icon" id="themeBtn" aria-label="Cambiar tema" title="Cambiar tema">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
        </button>
      </div>
    </div>
    <div class="bar bar-lg"><span style={`width:${all.pct}%`}></span></div>
  </header>

  <div class="controls">
    <div class="controls-in">
      <div class="searchrow">
        <div class="search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
          <label class="sr" for="q">Buscar por nombre o número</label>
          <input id="q" type="search" placeholder="Buscar por nombre o número…" autocomplete="off" spellcheck="false" />
        </div>
        <label class="sr" for="setSel">Expansión</label>
        <select class="sort" id="setSel">
          <option value="">Todas las expansiones</option>
          {catalog.map((s) => <option value={s.id}>{s.name}</option>)}
        </select>
      </div>
      <div class="filters" id="status">
        <button class="chip" data-status="all" aria-pressed="true">Todas</button>
        <button class="chip" data-status="missing" aria-pressed="false">Me faltan</button>
        <button class="chip" data-status="owned" aria-pressed="false">Tengo</button>
      </div>
    </div>
  </div>

  <main>
    {catalog.map((set) => {
      const p = progress(set.cards, owned);
      return (
        <section class="set" data-set={set.id}>
          <div class="set-head">
            <h2>{set.name}</h2>
            {hasSleeves && <span class:list={["sleeve", { owned: setHasSleeves(set.id) }]}>{setHasSleeves(set.id) ? "✓ Sleeve ETB" : "Falta sleeve ETB"}</span>}
            <span class="mono set-count">{p.owned}/{p.total}</span>
          </div>
          <div class="bar"><span style={`width:${p.pct}%`}></span></div>
          <ul class="grid">
            {(SLEEVE_IMGS[set.id] ?? []).map((f) => {
              const has = sleeves.has(f);
              return (
                <li class:list={["card", "sleeve-card", { owned: has }]} data-num="" data-name="Sleeve ETB" data-owned={has ? "1" : ""}>
                  <a class="thumb" href={`${base}sleeves/${f}`} target="_blank" rel="noopener">
                    <img src={`${base}sleeves/${f}`} alt={`Sleeve ETB — ${set.name}`} loading="lazy" />
                    {has && <span class="check" aria-label="La tengo">✓</span>}
                  </a>
                  <div class="meta">
                    <span class="code">ETB</span>
                    <span class="name">Sleeve</span>
                  </div>
                </li>
              );
            })}
            {set.cards.map((c) => {
              const has = owned.has(c.id);
              return (
                <li class:list={["card", { owned: has }]} data-num={c.num} data-name={c.name} data-owned={has ? "1" : ""}>
                  <div class="thumb">
                    <img src={c.img} alt={`${c.name} #${c.num} — ${set.name}`} loading="lazy" width="245" height="342" />
                    {has && <span class="check" aria-label="La tengo">✓</span>}
                  </div>
                  <div class="meta">
                    <span class="code">{cardCode(set, c.num)}</span>
                    <span class="name">{c.name}</span>
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      );
    })}
    <div class="empty" id="empty" hidden>
      <h2>Sin resultados</h2>
      <p>Prueba con otro nombre, número o quita algún filtro.</p>
    </div>
  </main>

  <!-- ponytail: print-only list + window.print(); browser "Save as PDF" does the rest, no PDF lib -->
  <section class="print-only">
    <h1>Faltantes — {heading}</h1>
    <p>Me faltan {all.total - all.owned} de {all.total} cartas.</p>
    {missingSleeves.length > 0 && (
      <div class="print-set">
        <h2>Sleeves ETB <span>({missingSleeves.length})</span></h2>
        <ul class="print-cards">
          {missingSleeves.map(({ set, f }) => (
            <li><img src={`${base}sleeves/${f}`} alt="" />{set.name}</li>
          ))}
        </ul>
      </div>
    )}
    {catalog.map((set) => {
      const missing = set.cards.filter((c) => !owned.has(c.id));
      return missing.length > 0 && (
        <div class="print-set">
          <h2>{set.name} <span>({missing.length})</span></h2>
          <ul class="print-cards">
            {missing.map((c) => <li><img src={c.img} alt="" /><span class="mono">{cardCode(set, c.num)}</span> {c.name}</li>)}
          </ul>
        </div>
      );
    })}
  </section>

  <footer>
    <p>Imágenes y datos: {credits} · © Pokémon / Nintendo / Creatures / GAME FREAK</p>
  </footer>

  <script src="../scripts/checklist.ts"></script>
</BaseLayout>
